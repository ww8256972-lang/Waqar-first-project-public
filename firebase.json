{
  "firestore": {
    "database": "ai-studio-android-waqarins-b07db193-f2b2-469a-b782-7cb127ebd6a1",
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/verify**",
        "destination": "/verify.html"
      },
      {
        "source": "/search**",
        "destination": "/search.html"
      },
      {
        "source": "/portal**",
        "destination": "/search.html"
      },
      {
        "source": "/download**",
        "destination": "/download.html"
      },
      {
        "source": "/app-info**",
        "destination": "/app-info.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "singleProjectMode": true
  }
}
